# MP-GEA Environment Configuration Example
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://mpgea.org

# Database URL
# For MySQL (Production):
# DATABASE_URL="mysql://mpgea_user:SecurePassword@localhost:3306/mpgea_db"
# For Local Development / Testing:
DATABASE_URL="file:./dev.db"

# Session Security
SESSION_SECRET="e9f52a7c4e8b1d3f6a0c5b8e2d4f7a1c9e8b2d3f4a5c6e7f8a9b0c1d2e3f4a5b"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_mpgea_mock_key"
RAZORPAY_KEY_SECRET="mock_secret_for_local_testing"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret"

# Transactional Email (SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@mpgea.org"
SMTP_PASS="your_smtp_password"
SMTP_FROM="MP-GEA Official <noreply@mpgea.org>"

# File Storage
UPLOAD_STORAGE_PATH="./storage"
MAX_UPLOAD_SIZE_MB=5
